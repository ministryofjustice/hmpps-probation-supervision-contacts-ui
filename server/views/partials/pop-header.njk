{% from "arns/components/rosh-badge/macro.njk" import roshBadge %}
{% from "mpop/components/pop-header/macro.njk" import popHeader %}
{% from "mpop/components/person-header/macro.njk" import personHeader %}
{% from "moj/components/alert/macro.njk" import mojAlert %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "arns/components/predictor-badge/macro.njk" import predictorBadge %}

{% set calculation = tierDetails.calculation %}

{% set headerErrors = [] %}
{% if prisonsUnavailable %}
    {% set headerErrors = (headerErrors.push({ text: "Photos and throughcare information are currently unavailable." }), headerErrors) %}
{% endif %}
{% if arnsUnavailable %}
    {% set headerErrors = (headerErrors.push({ text: "Risk information from the ARNS service is currently unavailable." }), headerErrors) %}
{% endif %}
{% if flags.enablePersonHeader and headerErrors.length %}
    {% set headerErrorsHtml %}
        {% if headerErrors.length > 1 %}
            <ul class="govuk-!-margin-top-0">
            {% for error in headerErrors %}
                <li>{{ error.text }}</li>
            {% endfor %}
            </ul>
        {% else %}
            <span>{{ headerErrors[0].text }}</span>
        {% endif %}
    {% endset %}
    {{ mojAlert({
        variant: "error",
        title: "There is a problem",
        showTitleAsHeading: true,
        attributes: { "data-qa": "headerErrors" },
        html: headerErrorsHtml
    }) }}
{% endif %}

{% set overallRisk = rosh.level if flags.enableNDeliusRosh else risksWidget.overallRisk %}
{% set riskName = 'Risk of serious harm' %}
{% if not flags.enableNDeliusRosh %}
    {% set riskName = 'ROSH' if riskData.assessments[0].rsr.band else 'Risk of serious harm' %}
    {% if overallRisk == 'VERY_HIGH' %}
        {% set overallRisk = 'VERY HIGH' %}
    {% endif %}
{% endif %}
{% set riskDataRosh = {
    assessments: [
        {
            rosh: {
                name: riskName,
                band: overallRisk
            }
        }
    ]
} %}
{% set riskBadges %}
{% if flags.enablePersonHeader %}
{% set showPredictorBadges = riskData.assessments[0].combinedSeriousReoffendingPredictor.band != "NOT APPLICABLE" %}
{% if (flags.enableNDeliusRosh or showPredictorBadges) and overallRisk and overallRisk !== 'NOT_FOUND' %}
{{ predictorBadge({
    data: riskDataRosh,
    predictor: 'rosh',
    showScore: false
 })}}
{% endif %}
{% if showPredictorBadges %}
{{ predictorBadge({
            data: riskData,
            predictor: 'combinedSeriousReoffendingPredictor',
            showScore: true
        })}}
{% if riskData.assessments[0].rsr.band %}
{{ predictorBadge({
                data: riskData,
                predictor: 'rsr',
                showScore: true
            })}}
{% endif %}
{% endif %}
{% else %}
{% if riskData
        .assessments[0]
        .combinedSeriousReoffendingPredictor
        .band != "NOT APPLICABLE" %}

{{ predictorBadge({
            data: riskData,
            predictor: 'combinedSeriousReoffendingPredictor',
            showScore: true
        })}}

{% if riskData
            .assessments[0]
            .rsr
            .band %}
{{ predictorBadge({
                data: riskData,
                predictor: 'rsr',
                showScore: true
            })}}
{% endif %}
{% if not flags.enableNDeliusRosh and overallRisk and overallRisk !== 'NOT_FOUND' %}
{{ predictorBadge({
    data: riskDataRosh,
    predictor: 'rosh',
    showScore: false
 })}}
{% endif %}
{% endif %}
{% if flags.enableNDeliusRosh and overallRisk and overallRisk !== 'NOT_FOUND' %}
{{ predictorBadge({
    data: riskDataRosh,
    predictor: 'rosh',
    showScore: false
 })}}
{% endif %}
{% endif %}
{% endset %}

{% set combinedRiskBadges %}
    {% if riskBadges and (riskBadges | trim) %}
        <div class="pop-header-risk-badges">
            {{ riskBadges | safe }}
        </div>
    {% endif %}
{% endset %}

{% set personRiskFlags %}
    {% if riskBadgeData  %}
        <div class="pop-header-risk-flags">
            {{ riskBadgeData | safe }}
        </div>
    {% endif %}
{% endset %}

{% if flags.enablePersonHeader %}
    {{ personHeader({
        name: headerPersonName.forename + ' ' + headerPersonName.surname,
        crn: headerCRN,
        dob: headerDob | dateWithYear,
        tier: (calculation.tierScore if flags.enablePersonHeaderTierV3 else tierCalculation.tierScore) | convertToTitleCase,
        historyHref: tierUrlV3 if flags.enablePersonHeaderTierV3 else headerTierLink,
        provisional: calculation.provisional if flags.enablePersonHeaderTierV3 else false,
        managedBy: managedBy.text,
        managedByName: managedBy.name,
        managedByLocation: managedBy.location,
        managedByHref: managedBy.href,
        photo: personPhotoSrc,
        riskBadges: combinedRiskBadges,
        personRiskFlags: riskBadgeData,
        collapsibleRiskFlags: collapsibleRiskFlags,
        personStatusTag: personStatusTag
    }) }}
{% else %}
{% if flags.enableSupervisionPackagePoPHeader %}
    {% set calculation = tierDetails.calculation %}
    <div data-qa="new-pop-header">
        {{ popHeader({
                    crn: headerCRN,
                    dob: headerDob | dateWithYear,
                    age: headerDob | yearsSince,
                    historyHref: tierUrlV3
                } | merge(calculation or {}) | merge({ tierScore: (calculation.tierScore if calculation else '') | convertToTitleCase })) }}
    </div>
{% else %}
    <div class="govuk-flex">
        <div>
            <ul class="govuk-list govuk-caption-m inline-list-from-tablet">
                <li>CRN:
                    <span data-qa='crn'>{{ headerCRN }}</span>
                    <span class='govuk-!-padding-left-3 govuk-!-padding-right-3 hide-mobile'>|</span>
                </li>
                <li>Date of birth:
                    <span data-qa='headerDateOfBirthValue'>{{ headerDob | dateWithYear }}</span>
                    (<span data-qa='headerDateOfBirthAge'>{{ headerDob | yearsSince }} years old</span>)
                    <span class='govuk-!-padding-left-3 govuk-!-padding-right-3 hide-mobile'>|</span>
                </li>
                <li>
                    <a href="{{ headerTierLink }}" data-qa="tierLink" class="govuk-link">
                        Tier: {{ tierCalculation.tierScore }}
                    </a>
                </li>
            </ul>
        </div>
    </div>
{% endif %}
<div class="moj-page-header-actions govuk-!-static-margin-bottom-4">
    <div class="moj-page-header-actions__title">
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">
            <span data-qa='name'>{{ headerPersonName.forename }}{{ ' ' }}{{ headerPersonName.surname }}</span>
        </h1>
        {% set overallRisk = rosh.level if flags.enableNDeliusRosh else risksWidget.overallRisk %}
{% set riskName = 'Risk of serious harm' %}
{% if not flags.enableNDeliusRosh %}
    {% set riskName = 'ROSH' if riskData.assessments[0].rsr.band else 'Risk of serious harm' %}
    {% if overallRisk == 'VERY_HIGH' %}
        {% set overallRisk = 'VERY HIGH' %}
    {% endif %}
{% endif %}
        {% set riskDataRosh = {
                assessments: [
                    {
                        rosh: {
                            name: riskName,
                            band: overallRisk
                        }
                    }
                ]
            } %}
        {% if riskData
                and riskData.assessments
                and riskData.assessments[0]
                and riskData.assessments[0].combinedSeriousReoffendingPredictor
                and riskData.assessments[0].combinedSeriousReoffendingPredictor.band != "NOT APPLICABLE" %}
            {{ predictorBadge({
                    data: riskData,
                    predictor: 'combinedSeriousReoffendingPredictor',
                    showScore: true
                }) }}
        {% endif %}
        {% if riskData
                and riskData.assessments
                and riskData.assessments[0]
                and riskData.assessments[0].rsr
                and riskData.assessments[0].rsr.band %}
            {{ predictorBadge({
                    data: riskData,
                    predictor: 'rsr',
                    showScore: true
                }) }}
        {% endif %}
        {% if overallRisk and overallRisk !== 'NOT_FOUND' %}
            {{ predictorBadge({
                    data: riskDataRosh,
                    predictor: 'rosh',
                    showScore: false
                }) }}
        {% endif %}
        {% set normalizedRoshData = roshData %}
        {% if roshData and roshData.assessment and roshData.assessment.overallRisk %}
            {% set normalizedRoshData = {
                    assessment: {
                        overallRisk: roshData.assessment.overallRisk | replace('_', ' '),
                        completedDate: roshData.assessment.completedDate,
                        risks: roshData.assessment.risks
                    },
                    httpStatus: roshData.httpStatus
                } %}
            {{ roshBadge({ data: normalizedRoshData }) }}
        {% endif %}
    </div>
    <div class="moj-page-header-actions__actions">
        {{ headerActions | safe }}
    </div>
</div>
<hr class="govuk-section-break--l">
{% endif %}
