{% extends "govuk/template.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "arns/components/predictor-badge/macro.njk" import predictorBadge %}

{% block head %}
  <link href="{{ '/assets/css/index.css' | assetMap }}" rel="stylesheet"/>
  {% if feComponents.cssIncludes %}
    {% for css in feComponents.cssIncludes %}
      <link href="{{ css }}" nonce="{{ cspNonce }}" rel="stylesheet"/>
    {% endfor %}
  {% else %}
    <link href="/assets/css/fallback_prob_fe_app_header.css" nonce="{{ cspNonce }}" rel="stylesheet"/>
    <link href="/assets/css/fallback_prob_fe_app_footer.css" nonce="{{ cspNonce }}" rel="stylesheet"/>
  {% endif %}
{% endblock %}

{% block pageTitle %}{{pageTitle | default(applicationName)}}{% endblock %}

{% block header %}
  {% include "./prob_fe_header.njk" %}
  {% block banner %}{% endblock %}
{% endblock %}

{% block footer %}
  {% include "./prob_fe_footer.njk" %}
{% endblock %}

{% block beforeContent %}
  {% if backLink %}
    {{ govukBackLink({
      href: backLink
    }) }}
  {% endif %}
{% endblock %}

{% block bodyStart %}
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="{{ '/assets/js/index.js' | assetMap }}"></script>
  {% if not feComponents.header %}
    <script type="module" src="{{ '/assets/js/fallback_prob_fe_app.js' | assetMap }}" nonce="{{ cspNonce }}"></script>
  {% endif %}
  <script nonce="{{ cspNonce }}">
    window.csrfToken = "{{ csrfToken }}";
  </script>
  <script nonce="{{ cspNonce }}">
    document.addEventListener('DOMContentLoaded', function () {
      document.initialiseTelemetry('{{ applicationInsightsConnectionString | default(' ') }}', '{{ applicationInsightsRoleName }}', '{{ user.username }}')
    })
  </script>
{% endblock %}
