<h3 class="govuk-heading-m">{{"Completing/updating your NAT ET Checklist" if update else "Completing your NAT ET Checklist"}}</h3>

{% set NATTipsHtml %}
<p class="govuk-body govuk-!-margin-bottom-2">
    If you are completing your NAT checklist for the first time:
</p>
<ul>
    <li>Download the NAT ET Checklist doc</li>
    <li>Open and edit in MS Word</li>
    <li>Save changes</li>
    <li>Upload to MPOP</li>
</ul>
{% if update %}
<p class="govuk-body govuk-!-margin-bottom-2">
    If you are updating the existing checklist:
</p>
<ul>
    <li>Download the current NAT ET Checklist document</li>
    <li>Open and edit in MS Word</li>
    <li>Save changes</li>
    <li>Upload in MPOP</li>
</ul>
{% endif %}
{% endset %}

{{ govukDetails({
    summaryText: "How to complete/update" if update else  "How to complete",
    classes: "govuk-!-margin-top-2 govuk-!-margin-bottom-4",
    attributes: {
        "data-qa": "NATTips"
    },
    html: NATTipsHtml,
    open: false
}) }}
