{% extends "../../partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "../../partials/breadcrumb.njk" import breadcrumb %}

{% block beforeContent %}
  {% set breadcrumbItems = [
    { title: "Cases", href: manageProbationUrl + "/case" },
    { title: headerPersonName.forename + " " + headerPersonName.surname, href: manageProbationUrl + "/case/" + crn },
    { title: "Contacts", href: manageProbationUrl + "/case/" + crn + "/activity-log" }
  ] %}
  {{ breadcrumb("Add a contact", breadcrumbItems) }}
{% endblock %}

{% block pageTitle %}
  {% if searchByKeywordTabActive %}
    Find a contact to add - search by keyword
  {% elif searchByCategoryTabActive %}
    Find a contact to add
  {% else %}
    Add a frequently used contact
  {% endif %}
{% endblock %}

{% block content %}
    {% include "../../partials/pop-header.njk" %}



    <div class="govuk-grid-row">
        <div class="govuk-grid-column-three-quarters">

            {% if flags and flags.searchContactsByCategory %}
                <h2 class="govuk-heading-l">Find a contact to add</h2>
            {% else %}
                <h2 class="govuk-heading-m">Add a frequently used contact</h2>
            {% endif %}

                {% if not (flags and flags.searchContactsByCategory) %}
                <p class="govuk-body">
                    You can currently add the most frequently used contacts using this service. For any other contacts,
                    <a
                        href="{{ ndeliusDeepLinkUrl }}"
                        target="_blank"
                        class="govuk-link"
                        data-ndelius-link="true"
                        data-back-url="{{ contactLogUrl }}">
                        use NDelius (opens in new tab)
                    </a>
                </p>
                {% endif %}

            {% if flags and flags.searchContactsByCategory %}
                <nav class="moj-sub-navigation" aria-label="Sub navigation">
                    <ul class="moj-sub-navigation__list">
                        <li class="moj-sub-navigation__item">
                            <a class="moj-sub-navigation__link govuk-link--no-visited-state"
                                href="/case/{{ crn }}/contacts/add-a-frequently-used-contact"
                                {% if not searchByCategoryTabActive and not searchByKeywordTabActive %}aria-current="page"{% endif %}>
                                Frequently used contacts
                            </a>
                        </li>
                        <li class="moj-sub-navigation__item">
                            <a class="moj-sub-navigation__link govuk-link--no-visited-state"
                                href="/case/{{ crn }}/contacts/find-contact-to-add"
                                data-qa="search-by-category-tab"
                                {% if searchByCategoryTabActive %}aria-current="page"{% endif %}>
                                Search by category
                            </a>
                        </li>
                        <li class="moj-sub-navigation__item">
                            <a class="moj-sub-navigation__link govuk-link--no-visited-state"
                                href="/case/{{ crn }}/contacts/search-keyword"
                                data-qa="search-by-keyword-tab"
                                {% if searchByKeywordTabActive %}aria-current="page"{% endif %}>
                                Search by keyword
                            </a>
                        </li>
                    </ul>
                </nav>

                {% if not searchByCategoryTabActive and not searchByKeywordTabActive %}
                    <div class="govuk-tabs__panel" id="frequently-used-contacts">
                        <h3 class="govuk-heading-m">Select a frequently used contact</h3>
                        <ul class="govuk-list app-contact-list govuk-grid-column-three-quarters" data-qa="frequentlyUsedContactList">
                            <li class="app-contact-list__item">
                                <a class="govuk-link" href="/case/{{ crn }}/contacts/add-a-frequently-used-contact?contactType=APPOINTMENT">Appointments</a>
                            </li>
                            {% for contact in frequentlyUsedContacts %}
                                <li class="app-contact-list__item">
                                    <a class="govuk-link" href="{{ contact.href }}">{{ contact.text }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>

                {% elif searchByCategoryTabActive %}
                    <div class="govuk-tabs__panel" id="search-by-category">
                        {% if errorMessages and errorMessages.categories %}
                            {% set errorList = [] %}
                            {% for field, message in errorMessages %}
                                {% set errorList = (errorList.push({ text: message, href: "#" + field }), errorList) %}
                            {% endfor %}
                            {{ govukErrorSummary({
                                titleText: "There is a problem",
                                classes: "govuk-!-margin-top-4 govuk-!-margin-bottom-6",
                                attributes: { "data-qa": "errorList" },
                                errorList: errorList
                            }) }}
                        {% endif %}
                        <form method="get" action="/case/{{ crn }}/contacts/find-contact-to-add" id="category-search-form">
                            <input type="hidden" name="lastCategories" value="{{ lastCategories }}">

                            {{ govukCheckboxes({
                                idPrefix: "categories",
                                name: "categories",
                                classes: "govuk-checkboxes--small app-checkboxes--two-columns",
                                fieldset: {
                                    legend: {
                                        html: '<h3 class="govuk-heading-m">Search by category</h3>',
                                        classes: "govuk-fieldset__legend--s"
                                    }
                                },
                                items: categoryCheckboxItems,
                                errorMessage: { text: errorMessages.categories } if errorMessages.categories
                            }) }}

                            <div class="govuk-button-group">
                                {{ govukButton({
                                    text: "Search",
                                    name: "action",
                                    value: "search",
                                    attributes: { "data-qa": "category-search-button" }
                                }) }}
                                <button class="govuk-button govuk-button--secondary" type="submit" name="action" value="clear" data-qa="category-clear-button">Clear</button>
                            </div>
                        </form>

                        {% if searchResults %}
                            <div data-qa="categorySearchResults">
                                <h3 class="govuk-heading-m">Search results</h3>
                                <p class="govuk-body">Showing {{ searchResults.count }} results</p>

                                {% for category in searchResults.categories %}
                                    <h3 class="govuk-heading-m">{{ category.name }}</h3>

                                    {% if category.items and category.items.length %}
                                        <ul class="govuk-list app-contact-list">
                                            {% for item in category.items %}
                                                <li class="app-contact-list__item">
                                                    <a class="govuk-link" href="{{ item.href }}">{{ item.displayName }}</a>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}

                                    {% for subcategory in category.subcategories %}
                                        <h4 class="govuk-heading-s govuk-!-font-size-19 govuk-!-margin-top-4 govuk-!-margin-bottom-1">
                                            {{ subcategory.name }}
                                        </h4>
                                        <ul class="govuk-list app-contact-list">
                                            {% for item in subcategory.items %}
                                                <li class="app-contact-list__item">
                                                    <a class="govuk-link" href="{{ item.href }}">{{ item.displayName }}</a>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% endfor %}
                                {% endfor %}

                                <p class="govuk-body govuk-!-margin-top-4">
                                    If you can't find the contact you need, try
                                    <a class="govuk-link" href="{{ ndeliusDeepLinkUrl }}" target="_blank" data-ndelius-link="true" data-back-url="{{ contactLogUrl }}">using NDelius (opens in new tab)</a>.
                                </p>
                            </div>
                        {% endif %}
                    </div>

                {% elif searchByKeywordTabActive %}
                    <div class="govuk-tabs__panel" id="search-by-keyword">
                        <div class="govuk-!-width-three-quarters">
                            <form method="get" action="/case/{{ crn }}/contacts/search-keyword" id="keyword-search-form">
                                <div class="govuk-form-group{% if errorMessages.keyword %} govuk-form-group--error{% endif %}">
                                    <h3 class="govuk-heading-m govuk-!-margin-bottom-1" id="keyword-label">Search by keyword or phrase</h3>
                                    <div class="govuk-hint" id="keyword-hint">For example email, safeguarding or CMS. Click the search icon to see a list of results.</div>
                                    {% if errorMessages.keyword %}
                                        <p class="govuk-error-message" id="keyword-error">
                                            <span class="govuk-visually-hidden">Error:</span> {{ errorMessages.keyword }}
                                        </p>
                                    {% endif %}
                                    <div class="keyword-search__input-wrapper">
                                        <input type="text"
                                            id="keyword-fallback"
                                            name="keyword"
                                            class="govuk-input keyword-search__fallback-input{% if errorMessages.keyword %} govuk-input--error{% endif %}"
                                            value="{{ keywordSearch }}"
                                            aria-labelledby="keyword-label"
                                            aria-describedby="keyword-hint{% if errorMessages.keyword %} keyword-error{% endif %}">
                                        <div id="keyword-autocomplete-container"
                                            class="keyword-search__autocomplete"
                                            style="display: none"
                                            data-suggestions="{{ contactTypeLinksJson }}"
                                            data-default-value="{{ keywordSearch }}">
                                        </div>
                                        <button type="submit" name="action" value="search" class="keyword-search__button" data-qa="keyword-search-button" aria-label="Search">
                                            <svg width="32" height="32" viewBox="16 13 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
                                                <circle cx="32" cy="29" r="8" stroke="white" stroke-width="2"/>
                                                <rect x="34.6064" y="36.0781" width="3" height="12" rx="1.5" transform="rotate(-38.2778 34.6064 36.0781)" fill="white"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>

                        {% if keywordSearchResults %}
                            <div data-qa="keywordSearchResults" class="govuk-!-width-three-quarters">
                                <h3 class="govuk-heading-m">Search results</h3>

                                {% if keywordSearchResults.count %}
                                    <p class="govuk-body">
                                        Showing <strong>{{ keywordSearchResults.count }}</strong>
                                        result{{ "s" if keywordSearchResults.count != 1 }} matching
                                        '<strong>{{ keywordSearchResults.keyword }}</strong>'
                                    </p>
                                    <ul class="govuk-list app-contact-list" data-qa="keywordResultList">
                                        {% for item in keywordSearchResults.items %}
                                            <li class="app-contact-list__item">
                                                <a class="govuk-link" href="{{ item.href }}">{{ item.displayName }}</a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <p class="govuk-body govuk-!-margin-top-4">
                                        No results match your search. Try searching for something else or
                                        <a class="govuk-link" href="{{ ndeliusDeepLinkUrl }}" target="_blank" data-ndelius-link="true" data-back-url="{{ contactLogUrl }}">use NDelius (opens in new tab)</a>
                                        to add a contact.
                                    </p>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

            {% else %}
                <form method="post" action="/case/{{ crn }}/contacts/add-a-frequently-used-contact" id="choose-contact-form"
                      data-ndelius-url="{{ ndeliusDeepLinkUrl }}"
                      data-back-url="{{ contactLogUrl }}">
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

                    {{ govukRadios({
                        name: "contactType",
                        idPrefix: "contactType",
                        fieldset: {
                            legend: {
                                text: "Select a contact",
                                classes: "govuk-fieldset__legend--s"
                            }
                        },
                        items: radioItems,
                        errorMessage: { text: errorMessages.contactType } if errorMessages.contactType
                    }) }}

                    {{ govukButton({
                        text: "Continue",
                        attributes: { "data-qa": "continue-button" }
                    }) }}
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
